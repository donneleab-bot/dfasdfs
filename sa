<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DENTAL PRO — Стоматология премиум-класса</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Segoe UI', sans-serif; color: #1a2b4a; background: #fff; line-height: 1.6; }
  a { text-decoration: none; }

  /* HEADER */
  header {
    position: fixed; top: 0; width: 100%; z-index: 100;
    background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
    padding: 18px 6%; display: flex; justify-content: space-between; align-items: center;
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
  }
  .logo { font-size: 22px; font-weight: 800; color: #1a2b4a; letter-spacing: 1px; }
  .logo span { color: #00a8b5; }
  nav a { color: #1a2b4a; margin-left: 28px; font-size: 15px; font-weight: 500; transition: 0.3s; }
  nav a:hover { color: #00a8b5; }
  .header-phone { font-weight: 700; color: #1a2b4a; margin-left: 30px; }
  .header-phone:hover { color: #00a8b5; }

  /* HERO */
  .hero {
    min-height: 100vh; display: flex; align-items: center;
    padding: 140px 6% 80px;
    background: linear-gradient(135deg, #f0fbff 0%, #ffffff 60%);
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; top: -200px; right: -200px;
    width: 600px; height: 600px; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,168,181,0.12), transparent 70%);
  }
  .hero-content { max-width: 620px; position: relative; z-index: 2; }
  .hero h1 {
    font-size: clamp(32px, 5vw, 54px); line-height: 1.15;
    margin-bottom: 24px; font-weight: 800; color: #1a2b4a;
  }
  .hero h1 span { color: #00a8b5; }
  .hero p { font-size: 18px; color: #5a6b7f; margin-bottom: 36px; }
  .hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 16px 36px; border-radius: 50px;
    font-weight: 700; font-size: 15px; transition: 0.3s; cursor: pointer; border: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, #00a8b5, #007d8a); color: #fff;
    box-shadow: 0 10px 30px rgba(0,168,181,0.35);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0,168,181,0.5); }
  .btn-outline {
    background: transparent; color: #1a2b4a; border: 2px solid #1a2b4a;
  }
  .btn-outline:hover { background: #1a2b4a; color: #fff; }

  .hero-stats {
    display: flex; gap: 40px; margin-top: 50px; flex-wrap: wrap;
  }
  .stat h3 { font-size: 32px; color: #00a8b5; font-weight: 800; }
  .stat p { font-size: 13px; color: #7a8a9f; }

  /* SECTIONS */
  section { padding: 90px 6%; }
  .section-title { text-align: center; margin-bottom: 60px; }
  .section-title h2 { font-size: clamp(28px, 4vw, 40px); color: #1a2b4a; margin-bottom: 12px; }
  .section-title p { color: #7a8a9f; font-size: 17px; }

  /* SERVICES */
  .services { background: #f7fbfd; }
  .services-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;
  }
  .service-card {
    background: #fff; padding: 36px 28px; border-radius: 20px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05); transition: 0.3s;
    border: 1px solid #eef4f8;
  }
  .service-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,168,181,0.15); }
  .service-icon {
    width: 56px; height: 56px; border-radius: 16px;
    background: linear-gradient(135deg, #00a8b5, #007d8a);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; margin-bottom: 20px;
  }
  .service-card h3 { font-size: 19px; margin-bottom: 12px; color: #1a2b4a; }
  .service-card p { color: #7a8a9f; font-size: 14px; margin-bottom: 16px; }
  .service-price { color: #00a8b5; font-weight: 800; font-size: 20px; }

  /* ADVANTAGES */
  .advantages-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 30px;
  }
  .advantage { text-align: center; padding: 20px; }
  .advantage-num {
    font-size: 48px; font-weight: 800; color: #00a8b5; opacity: 0.25; margin-bottom: 10px;
  }
  .advantage h3 { font-size: 18px; margin-bottom: 10px; color: #1a2b4a; }
  .advantage p { color: #7a8a9f; font-size: 14px; }

  /* DOCTORS */
  .doctors { background: #f7fbfd; }
  .doctors-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px;
  }
  .doctor-card {
    background: #fff; border-radius: 20px; overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05); transition: 0.3s; text-align: center;
    padding-bottom: 24px;
  }
  .doctor-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,168,181,0.15); }
  .doctor-photo {
    height: 260px; background: linear-gradient(135deg, #d4eef2, #a8dde4);
    display: flex; align-items: center; justify-content: center;
    font-size: 60px; color: #fff;
  }
  .doctor-card h3 { margin: 20px 0 6px; font-size: 18px; color: #1a2b4a; }
  .doctor-card .spec { color: #00a8b5; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .doctor-card p { color: #7a8a9f; font-size: 13px; padding: 0 20px; }

  /* REVIEWS */
  .reviews-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;
  }
  .review-card {
    background: #fff; padding: 30px; border-radius: 20px;
    border: 1px solid #eef4f8; box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  }
  .review-stars { color: #ffb400; margin-bottom: 14px; font-size: 18px; }
  .review-text { color: #4a5b6f; font-size: 15px; margin-bottom: 20px; font-style: italic; }
  .review-author { font-weight: 700; color: #1a2b4a; font-size: 14px; }
  .review-author span { display: block; font-weight: 400; color: #9aa8b8; font-size: 13px; }

  /* CTA */
  .cta {
    background: linear-gradient(135deg, #00a8b5, #007d8a);
    color: #fff; text-align: center; border-radius: 30px;
    margin: 0 6% 90px; padding: 70px 30px;
    box-shadow: 0 30px 60px rgba(0,168,181,0.3);
  }
  .cta h2 { font-size: clamp(26px, 4vw, 38px); margin-bottom: 16px; }
  .cta p { font-size: 17px; opacity: 0.9; margin-bottom: 36px; }
  .cta .btn-primary {
    background: #fff; color: #007d8a; box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  .cta .btn-primary:hover { background: #f0f0f0; }

  /* FORM */
  .form-block { max-width: 560px; margin: 0 auto; }
  .form-block input, .form-block select {
    width: 100%; padding: 16px 20px; border-radius: 12px;
    border: 1px solid #d4e4ec; font-size: 15px; margin-bottom: 14px;
    font-family: inherit; background: #fafdff;
  }
  .form-block input:focus, .form-block select:focus { outline: none; border-color: #00a8b5; }
  .form-block .btn { width: 100%; }

  /* FOOTER */
  footer {
    background: #1a2b4a; color: #9aa8b8; padding: 50px 6% 30px;
  }
  .footer-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px; margin-bottom: 40px;
  }
  .footer-col h4 { color: #fff; margin-bottom: 16px; font-size: 16px; }
  .footer-col a, .footer-col p { color: #9aa8b8; font-size: 14px; display: block; margin-bottom: 10px; }
  .footer-col a:hover { color: #00a8b5; }
  .footer-bottom { border-top: 1px solid #2a3b5a; padding-top: 24px; text-align: center; font-size: 13px; }

  @media (max-width: 768px) {
    nav { display: none; }
    .hero-stats { gap: 24px; }
  }
</style>
</head>
<body>

<header>
